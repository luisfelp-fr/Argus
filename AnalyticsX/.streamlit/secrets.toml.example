# Exemplo de configuração de acesso do Argus AnalyticsX.
#
# LOCAL:  copie este arquivo para  .streamlit/secrets.toml  (sem ".example")
#         e preencha com seus valores. NÃO faça commit do secrets.toml real.
# NUVEM:  cole o conteúdo (sem comentários) em
#         Streamlit Cloud → seu app → Settings → Secrets.
#
# 1) Defina um salt aleatório e longo (gere um novo):
#       python -c "import secrets; print(secrets.token_hex(24))"
# 2) Para cada usuário, gere o hash da senha com esse mesmo salt:
#       python gen_password_hash.py
#    e cole o par "usuario" = "<hash>" em [auth.users].

[auth]
salt = "troque-por-uma-frase-aleatoria-bem-longa"

[auth.users]
# "usuario" = "<hash gerado por gen_password_hash.py>"
"admin" = "COLE_AQUI_O_HASH"
